{
  "name": "locs_app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "expo lint",
    "gen:types": "cd ../locs_server && npx supabase gen types typescript --linked > ../Locs_app/types/database.types.ts",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "start:test": "node --env-file=.env.test node_modules/expo/bin/cli start",
    "android:test": "node --env-file=.env.test node_modules/expo/bin/cli run:android",
    "postinstall": "patch-package",
    "web:build": "node --env-file-if-exists=.env web/build.mjs",
    "web:deploy": "npm run web:build && wrangler pages deploy web/dist --project-name locsapp --branch main"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "^2.110.8",
    "expo": "~57.0.25",
    "expo-apple-authentication": "~57.0.2",
    "expo-constants": "^57.0.7",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "^57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "^20.1.1",
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.5",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "wrangler": "^4.141.0"
  },
  "overrides": {
    "image-size": "^2.0.4",
    "decode-uri-component": "^0.5.0",
    "uuid": "^11.1.1"
  },
  "private": true,
  "license": "UNLICENSED"
}
